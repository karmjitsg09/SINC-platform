# SINC Platform — Production Hosting Dashboard Environment Variables (Names Only)
# Configure these variables in your hosting provider's project settings (e.g. Vercel, Supabase, Cloudflare)

# Frontend Public Variables (Safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-Side Variables (Strictly private; never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_IDEMPOTENCY_STORE=
POST_VISIBILITY=

