# Supabase Configuration Example
# Copy this file to .env and fill in your Supabase credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: Custom OAuth Redirect URL (Defaults to window.location.origin, e.g. http://localhost:3000)
# VITE_AUTH_REDIRECT_URL=http://localhost:3000

# Web Push Notification Configuration (VAPID)
# VITE_VAPID_PUBLIC_KEY is safe for frontend consumption
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY must remain server-side secret only (Supabase Edge Functions / server env)
VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID contact subject (RFC 8292 mailto: or https: URI)
VAPID_SUBJECT=mailto:notifications@yourdomain.com
