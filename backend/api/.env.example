# SINC Backend API — Environment Variables Template
# Server Configuration
PORT=
NODE_ENV=
API_PREFIX=

# CORS Allowlist (comma-separated origins)
CORS_ORIGINS=

# Database Connections
# Runtime connection (Supabase Session Pooler or direct connection)
DATABASE_URL=
# Direct connection for schema migrations
DIRECT_URL=

# Redis Configuration (rate limiting, Socket.IO adapter, BullMQ)
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Supabase Auth Integration
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=

# Supabase Storage (Service role for signed URL generation)
SUPABASE_SECRET_KEY=

# Rate Limiting
THROTTLE_TTL=
THROTTLE_LIMIT=
